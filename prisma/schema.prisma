generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  email         String         @unique(map: "email") @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  displayName   String         @map("display_name") @db.VarChar(255)
  language      String         @default("fr") @db.VarChar(5)
  avatarUrl     String?        @map("avatar_url") @db.VarChar(512)
  role          String         @default("subscriber") @db.VarChar(20)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  axsCommunityExpire   DateTime?      @map("axs_community_expire") @db.DateTime(0)
  userTrainings        UserTraining[]
  logErrors            LogError[]

  @@map("users")
}

model Training {
  id                    Int      @id @default(autoincrement()) @db.UnsignedInt
  title                 String   @db.VarChar(255)
  language              String   @default("fr") @db.VarChar(5)
  descriptionHtml       String   @map("description_html") @db.LongText
  stripeProductId       String?  @map("stripe_product_id") @db.VarChar(255)
  stripePriceId         String?  @map("stripe_price_id") @db.VarChar(255)
  confirmationEmailHtml String?  @map("confirmation_email_html") @db.LongText
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  code                  String   @unique(map: "code") @default("") @db.VarChar(50)
  pageUrl               String?  @map("page_url") @db.VarChar(255)
  axsCommunityMonths    Int?     @map("axs_community_months") @db.UnsignedInt

  @@map("trainings")
}

model UserTraining {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  userId          Int      @map("user_id") @db.UnsignedInt
  trainingCode    String   @map("training_code") @db.VarChar(50)
  stripeSessionId String?  @map("stripe_session_id") @db.VarChar(255)
  amountCt        Int?     @map("amount_ct") @db.UnsignedInt
  currency        String?  @db.VarChar(3)
  purchasedAt     DateTime @default(now()) @map("purchased_at") @db.DateTime(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_trainings_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("user_trainings")
}

model LogError {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  route     String   @db.VarChar(255)
  message   String   @db.Text
  stack     String?  @db.Text
  userId    Int?     @map("user_id") @db.UnsignedInt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "log_errors_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("log_errors")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  key       String   @db.VarChar(50)
  language  String   @db.VarChar(5)
  subject   String   @db.VarChar(255)
  html      String   @db.MediumText
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([key, language], map: "uniq_key_lang")
  @@map("email_templates")
}
